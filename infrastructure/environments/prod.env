# Production — gated by GitHub Environment "production" (required reviewers: ≥ 1).

SPRING_PROFILES_ACTIVE=prod
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_SNAKEFORGED=INFO

SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/snakeforged-prod;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL

OPERATOR_TOKEN_SSM_PARAMETER=/snakeforged/prod/operator-token

