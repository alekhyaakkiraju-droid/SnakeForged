# Staging — promotion from dev is manual (GitHub Environment: staging).

SPRING_PROFILES_ACTIVE=staging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_SNAKEFORGED=INFO

SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/snakeforged-staging;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL

OPERATOR_TOKEN_SSM_PARAMETER=/snakeforged/staging/operator-token

# GitHub Actions promotion workflow_dispatch — set as Environment variables / secrets:
# ECS_CLUSTER_STAGING=<terraform ecs_cluster_name>
# ECS_SERVICE_STAGING=<terraform ecs_service_name>
# DEPLOY_URL_STAGING=https://snakeforged-staging.example.com
