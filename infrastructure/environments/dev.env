# Development (dev) — application and CI/CD defaults.
# ECS task env is primarily set via Terraform (`infrastructure/ecs.tf`); this file
# documents the intended runtime profile and troubleshooting overrides.
#
# Terraform outputs (`terraform output`): ecs_cluster_name, ecs_service_name, application_url

SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_SNAKEFORGED=DEBUG

# Embedded H2 file path (writable path inside container; align with ECS volume if used)
SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/snakeforged-dev;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL

# Matches `operator_token_ssm_path` in Terraform for this workspace (override per account)
OPERATOR_TOKEN_SSM_PARAMETER=/snakeforged/operator-token

# GitHub Actions / Forge: populate from secrets — see docs/rollback-procedure.md
# AWS_REGION=us-east-1
# ECS_CLUSTER_DEV=<terraform output ecs_cluster_name for dev>
# ECS_SERVICE_DEV=<terraform output ecs_service_name for dev>
# DEPLOY_URL_DEV=https://snakeforged-dev.example.com
# ECR_REPOSITORY=snakeforged
# ECR_REGISTRY=<account>.dkr.ecr.<region>.amazonaws.com
